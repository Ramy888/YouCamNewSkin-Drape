    await Promise.all(queued.map((r) => this.runLiveJob(String(r.id))));
    if (this.sql.exec(`SELECT 1 FROM jobs WHERE status = 'queued' AND ledger_id IS NOT NULL LIMIT 1`).length) {
      await this.ctx.storage.setAlarm(Date.now() + 1000);
